COGNODB_URI=bolt+s://<your_database>.cognodb.com
COGNODB_USER=<your_username/id>
COGNODB_PASSWORD=<your_password>


NEO4J_URI=neo4j+s://<your_database>.neo4j.io
NEO4J_USER=<your_username/id>
NEO4J_PASSWORD=<your_password>


# Memgraph Cloud (hosted free tier — no Docker needed)
MEMGRAPH_URI=bolt+ssc://<your_database>
MEMGRAPH_USER=<your_username/id>
MEMGRAPH_PASSWORD=<your_password>


# FalkorDB — Redis-based graph database. 5th platform, genuinely different
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD= <your_password> # Usually no password

NEO4J_SELFHOSTED_URI=bolt://localhost:7688
NEO4J_SELFHOSTED_USER=<your_username/id>
NEO4J_SELFHOSTED_PASSWORD=<your_password>